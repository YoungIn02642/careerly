# ── Careerly 백엔드 환경변수 견본 ──
# 이 파일을 복사해 같은 폴더에 ".env" 로 만들고, 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore 에 있어 깃에 올라가지 않는다. 키를 여기(.env.example)에
# 넣지 말 것 — 이 파일은 커밋된다.

# 공공데이터포털(data.go.kr) 서비스키 (Decoding 키 권장)
# 발급: https://www.data.go.kr/data/15074404/openapi.do → 활용신청 후 마이페이지
# 계정당 하나이며, 활용신청이 승인된 API 라면 이 키 하나로 모두 호출된다.
#   쓰는 곳: scripts/fetch-ncs-taxonomy.js   (NCS 분류)
#           scripts/fetch-public-orgs.js    (공공기관 지정현황 → 공공기관 판별)
#           scripts/fetch-ftc-groups.js     (대규모기업집단 → 대기업 판별)
DATA_GO_KR_SERVICE_KEY=

# 고용24(워크넷) 오픈API 인증키 — data.go.kr 키와 별개다.
# 고용24 는 자체 게이트웨이(openapi.work.go.kr)를 쓰고 인증키도 따로 발급한다.
# 발급: https://openapi.work.go.kr → 오픈API 신청 → 승인 후 발급된 인증키
#   쓰는 곳: scripts/fetch-worknet-jobs.js  (채용공고 → 직무 트렌드 = 역량 요구 빈도)
#           공채기업정보(중견기업 판별)는 요청 URL 미확보 상태 — 별도 오퍼레이션이다.
# 비워두면 자소서 코치의 '시장 비율' 배지와 중견기업 자동판정만 빠지고,
# 나머지 기능은 전부 정상 동작한다.
WORK24_API_KEY=

# 배포 시에만 필요 (개발 중에는 비워둬도 됨)
# NODE_ENV=production
# ALLOWED_ORIGINS=https://your-deployed-domain.com

# CAS 정성 스펙 AI 분석 (POST /api/cas/analyze)
# 기본은 로컬 Ollama — API 키·쿼터·네트워크가 필요 없다.
#   1) https://ollama.com 설치 후  2) ollama pull qwen3:8b
# CAS_AI_PROVIDER=ollama   # ollama(기본) | groq
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b
# CAS_AI_TIMEOUT_MS=240000

# 회사 뉴스 (자소서 '지원동기' 소재 · GET /api/news/company)
# 비워두면 키 없이 동작하는 웹 검색으로 대신한다(정확도가 낮고 날짜가 없다).
# 발급처가 둘인데 **어느 쪽이든 된다**. 응답 형식이 같아 서버가 자동으로 가려 쓴다.
#   · NCP 콘솔 → NAVER API Hub → 검색   (Client ID/Secret. Secret 40자)
#   · https://developers.naver.com → 애플리케이션 등록 → 사용 API 에 '검색' (Secret 10자 안팎)
# 주의: 두 콘솔 값을 하나씩 섞어 넣으면 양쪽 다 인증 실패한다.
# 확인: node scripts/check-news-api.js
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# NEWS_PROVIDER=ncp       # ncp | naver | web (기본: 키가 있으면 자동 판별)
