backend/node_modules/

.env
backend/.env

# Claude Code 개인 설정. 허용 명령 목록에 접속 문자열이 그대로 들어가는 일이 있어
# (실제로 운영 MYSQL_URL 이 들어 있었다) 절대 커밋하지 않는다.
# .claude/launch.json 은 팀이 공유하는 실행 설정이라 커밋한다.
.claude/settings.local.json

data/db.json
backend/data/db.json

# DART 고유번호 색인. 커밋하지 않는다 — 공시대상 전체 11만여 건이라 6MB 이고,
# 다시 받을 때마다 그 크기가 히스토리에 통째로 쌓인다. 우리가 만든 자료가 아니라
# DART 가 매일 주는 원본이라 받아 오면 그만이다.
#   배포: 빌드 단계에서 자동 (루트 package.json 의 build)
#   로컬: npm run build   (키가 없으면 건너뛴다 — 기업분석만 빈다)
backend/data/dart-corps.json
# 공공기관 채용공고(잡알리오) — 하루 한 번 새로 받는 원본이라 커밋하지 않는다.
# 16-9 의 교훈: 넣기 전에 '비싸게 만든 값'이 같이 들어 있지 않은지 확인했다 —
# 이 파일은 API 가 통째로 주는 원본뿐이고 계산해 만든 값이 없다.
# 없으면 회사 리포트의 공고 칸만 빈다(서버는 뜬다).
backend/data/alio-jobs.json
backend/data/.alio-probe.json

backend/data/users.json
backend/data/profiles.json

